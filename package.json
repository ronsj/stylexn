{
  "name": "react-stylexn-app",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install && pnpm --filter stylexn build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @stylexn/web test:e2e",
    "check:styles": "node packages/stylexn/dist/bin.mjs check --report-web-only --strict packages/shared/src apps/mobile",
    "build": "pnpm --filter stylexn build",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:styles && pnpm --filter stylexn compat:check && pnpm --filter stylexn pack:check"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "stylexn": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0"
}
