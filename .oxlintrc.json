{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "react-hooks"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["apps/mobile/**", "**/*.native.{ts,tsx}"],
      "rules": {
        "react/style-prop-object": "off"
      }
    },
    {
      "files": ["packages/shared/**"],
      "rules": {
        "stylexn/compat": "error"
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.next/**", "**/.expo/**"],
  "jsPlugins": ["./packages/stylexn/src/lint/eslint-plugin.ts"]
}
