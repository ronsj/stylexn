{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "react-hooks"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.next/**", "**/.expo/**"]
}
