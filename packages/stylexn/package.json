{
  "name": "stylexn",
  "version": "0.1.0",
  "private": true,
  "description": "Author styles with the StyleX API and render them on React Native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ronsj/react-stylexn-app.git",
    "directory": "packages/stylexn"
  },
  "bin": {
    "stylexn": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "COMPATIBILITY.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "react-native": "./src/runtime/index.ts",
      "default": "./src/web.ts"
    },
    "./native": "./src/runtime/index.ts",
    "./elements": {
      "react-native": "./src/elements/native.ts",
      "default": "./src/elements/web.ts"
    },
    "./compiler": {
      "types": "./src/compiler.ts",
      "default": "./dist/compiler.mjs"
    },
    "./babel": {
      "types": "./src/babel/index.ts",
      "default": "./dist/babel.cjs"
    },
    "./eslint-plugin": {
      "types": "./src/lint/eslint-plugin.ts",
      "default": "./dist/eslint-plugin.mjs"
    },
    "./check": {
      "types": "./src/cli/check.ts",
      "default": "./dist/check.mjs"
    },
    "./testing/react-native": "./src/testing/react-native.ts",
    "./elements.css": "./dist/elements.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "react-native": {
          "types": "./dist/runtime/index.d.ts",
          "default": "./dist/runtime/index.js"
        },
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "./native": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "./elements": {
        "react-native": {
          "types": "./dist/elements/native.d.ts",
          "default": "./dist/elements/native.js"
        },
        "types": "./dist/elements/web.d.ts",
        "default": "./dist/elements/web.js"
      },
      "./elements.css": "./dist/elements.css",
      "./compiler": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.mjs"
      },
      "./babel": {
        "types": "./dist/babel/index.d.ts",
        "default": "./dist/babel.cjs"
      },
      "./eslint-plugin": {
        "types": "./dist/lint/eslint-plugin.d.ts",
        "default": "./dist/eslint-plugin.mjs"
      },
      "./check": {
        "types": "./dist/cli/check.d.ts",
        "default": "./dist/check.mjs"
      },
      "./testing/react-native": {
        "types": "./dist/testing/react-native.d.ts",
        "default": "./dist/testing/react-native.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "STYLEXN_BENCH=1 vitest run src/runtime/props.bench.test.tsx",
    "build": "node scripts/build.mjs",
    "compat:docs": "node --experimental-strip-types scripts/compat-docs.ts",
    "compat:check": "node --experimental-strip-types scripts/compat-docs.ts --check",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@stylexjs/stylex": "^0.19.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.3",
    "esbuild": "^0.28.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@babel/core": "^7.26.0",
    "@stylexjs/stylex": ">=0.15.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@stylexjs/stylex": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
