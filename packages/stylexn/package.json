{
  "name": "stylexn",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "stylexn": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "react-native": "./src/runtime/index.ts",
      "default": "./src/web.ts"
    },
    "./native": "./src/runtime/index.ts",
    "./elements": {
      "react-native": "./src/elements/native.ts",
      "default": "./src/elements/web.ts"
    },
    "./compiler": {
      "types": "./src/compiler.ts",
      "default": "./dist/compiler.mjs"
    },
    "./babel": {
      "types": "./src/babel/index.ts",
      "default": "./dist/babel.cjs"
    },
    "./eslint-plugin": {
      "types": "./src/lint/eslint-plugin.ts",
      "default": "./dist/eslint-plugin.mjs"
    },
    "./check": {
      "types": "./src/cli/check.ts",
      "default": "./dist/check.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@stylexjs/stylex": "^0.19.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.3",
    "esbuild": "^0.28.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@babel/core": "^7.26.0",
    "@stylexjs/stylex": ">=0.15.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@stylexjs/stylex": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
